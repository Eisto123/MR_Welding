  instructionNameText: {fileID: 9174482871466989275}
  instructionParagraphText: {fileID: 3631490887266891775}
  stepInstructions:
  - stepType: 0
    instructionName: Place Physical Plate
    instructionParagraph: Please place the physical plate on the table in front of
      you.
  - stepType: 1
    instructionName: Auto Placement
    instructionParagraph: Please look at the plate until you see the green virtual
      plate appear on the physical plate.
  - stepType: 2
    instructionName: Alignment
    instructionParagraph: Please use the trigger button to align the virtual plate
      with the physical plate perfectly.
  - stepType: 3
    instructionName: Welding
    instructionParagraph: Please use grab button the grab the welding gun and press
      trigger to weld on the plate.
  - stepType: 4
    instructionName: Your Result
    instructionParagraph: Please check the result on the result panel/
